# Copy to .env.local and fill in one provider. .env.local is never committed.

# Groq (https://console.groq.com): fast open models with a free tier.
GROQ_API_KEY=
# Optional: a model from your Groq console. Defaults to llama-3.3-70b-versatile.
# GROQ_MODEL=

# Anthropic (https://console.anthropic.com): Claude models.
ANTHROPIC_API_KEY=
# Optional: defaults to claude-opus-5-5; claude-haiku-5-5 is much cheaper.
# AI_MODEL=claude-haiku-5-5
# Optional: an Anthropic-compatible endpoint you are permitted to use from apps.
# ANTHROPIC_BASE_URL=

# Optional: force a provider ("groq" or "anthropic") when both keys are set.
# AI_PROVIDER=
