# Copy to .env.local and fill in. .env.local is never committed.

# Anthropic API key for the AI assistant (https://console.anthropic.com).
ANTHROPIC_API_KEY=

# Optional: model to use. Defaults to claude-opus-5-5; claude-haiku-5-5 is much cheaper.
# AI_MODEL=claude-haiku-5-5

# Optional: an Anthropic-compatible endpoint you are permitted to use from apps.
# ANTHROPIC_BASE_URL=
